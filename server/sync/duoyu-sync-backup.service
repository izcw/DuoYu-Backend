[Unit]
Description=Encrypted DuoYu sync database backup

[Service]
Type=oneshot
TimeoutStartSec=40min
ExecStartPre=/www/server/panel/pyenv/bin/python /www/server/duoyu-backup-access.py
ExecStartPost=/www/server/panel/pyenv/bin/python /www/server/duoyu-backup-access.py
ExecStart=/bin/node /www/wwwroot/duoyu-sync/src/backup.mjs
UMask=0077
